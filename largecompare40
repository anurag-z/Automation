import pandas as pd
import os

# --- 1. CONFIGURATION ---
folder_path = r'C:\Users\C302461\OneDrive - Thomson Reuters Incorporated\Documents\IDesign\New folder\Excel\Data'
file_a_path = os.path.join(folder_path, 'merged_master_data.csv')
file_b_path = os.path.join(folder_path, 'merged_field_analysis.csv')
output_excel = os.path.join(folder_path, 'Final_Comparison_Report_With_Summary.xlsx')

def run_full_process():
    # --- 2. LOAD & COMPARE ---
    print("Step 1: Loading files...")
    df_a = pd.read_csv(file_a_path, dtype=str).fillna("")
    df_b = pd.read_csv(file_b_path, dtype=str).fillna("")

    match_cols = ["area", "screen name", "screen number", "field name", "field number", "level", "row", "column"]
    
    df_a.columns = [c.lower().strip() for c in df_a.columns]
    df_b.columns = [c.lower().strip() for c in df_b.columns]

    print("Step 2: Identifying differences...")
    merged = pd.merge(df_a, df_b, on=match_cols, how='outer', suffixes=('_base', ''), indicator=True)

    merged['comparison_status'] = 'COMMON'
    merged.loc[merged['_merge'] == 'left_only', 'comparison_status'] = 'DELETED ROW'
    merged.loc[merged['_merge'] == 'right_only', 'comparison_status'] = 'NEW ROW'

    print("Step 3: Checking for modifications...")
    common_mask = (merged['_merge'] == 'both')
    for col in df_b.columns:
        if col in match_cols or col == '_merge': continue
        base_col = f"{col}_base"
        if base_col in merged.columns:
            diff_mask = common_mask & (merged[base_col].str.strip() != merged[col].str.strip())
            merged.loc[diff_mask, 'comparison_status'] = 'MODIFIED'

    merged = merged.drop(columns=['_merge'])

    # --- 3. GENERATE SUMMARY DATA ---
    summary_counts = merged['comparison_status'].value_counts().reset_index()
    summary_counts.columns = ['Status', 'Count']

    # --- 4. WRITE TO EXCEL ---
    print("Step 4: Writing to Excel with Summary and Highlights...")
    rows_per_sheet = 1000000 
    total_rows = len(merged)
    status_idx = merged.columns.get_loc("comparison_status")

    with pd.ExcelWriter(output_excel, engine='xlsxwriter') as writer:
        workbook = writer.book
        
        # Formats
        fmt_new = workbook.add_format({'bg_color': '#C6EFCE'}) 
        fmt_mod = workbook.add_format({'bg_color': '#FFFF99'}) 
        fmt_del = workbook.add_format({'bg_color': '#E0E0E0'}) 
        fmt_bold = workbook.add_format({'bold': True, 'font_size': 12, 'bg_color': '#D3D3D3'})

        # --- A. WRITE SUMMARY SHEET ---
        summary_sheet = workbook.add_worksheet('Executive Summary')
        summary_sheet.write('A1', 'Comparison Results Summary', fmt_bold)
        summary_sheet.write('A3', 'Status', fmt_bold)
        summary_sheet.write('B3', 'Count', fmt_bold)
        
        for row_num, (status, count) in enumerate(summary_counts.values):
            summary_sheet.write(row_num + 3, 0, status)
            summary_sheet.write(row_num + 3, 1, count)
        
        summary_sheet.set_column('A:A', 25)
        summary_sheet.set_column('B:B', 15)

        # --- B. WRITE DATA SHEETS ---
        for i in range(0, total_rows, rows_per_sheet):
            chunk = merged.iloc[i : i + rows_per_sheet]
            sheet_name = f"Data_Part_{i // rows_per_sheet + 1}"
            print(f"   - Writing {sheet_name}...")
            
            chunk.to_excel(writer, sheet_name=sheet_name, index=False)
            worksheet = writer.sheets[sheet_name]
            worksheet.freeze_panes(1, 0)
            
            col_letter = chr(65 + status_idx) if status_idx < 26 else "Z"

            worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                'type':     'formula',
                'criteria': f'=${col_letter}2="NEW ROW"',
                'format':   fmt_new
            })
            worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                'type':     'formula',
                'criteria': f'=${col_letter}2="MODIFIED"',
                'format':   fmt_mod
            })
            worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                'type':     'formula',
                'criteria': f'=${col_letter}2="DELETED ROW"',
                'format':   fmt_del
            })

    print(f"\n🚀 ALL DONE! Total Records: {total_rows}")
    print(f"File saved: {output_excel}")

if __name__ == "__main__":
    run_full_process()
