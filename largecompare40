import pandas as pd
import os
from datetime import datetime

# --- 1. CONFIGURATION ---
folder_path = r'C:\Users\C302461\OneDrive - Thomson Reuters Incorporated\Documents\IDesign\New folder\Excel\Data'
file_a_path = os.path.join(folder_path, 'merged_master_data.csv')
file_b_path = os.path.join(folder_path, 'merged_field_analysis.csv')

# Adding a timestamp to the filename (e.g., Report_20260317_1430.xlsx)
timestamp = datetime.now().strftime("%Y%m%d_%H%M")
output_excel = os.path.join(folder_path, f'Final_Comparison_Report_{timestamp}.xlsx')

def run_full_process():
    try:
        # --- 2. LOAD & NORMALIZE HEADERS ---
        print("Step 1: Loading files and fixing header casing...")
        # Reading as strings to prevent leading zero loss or decimal errors
        df_a = pd.read_csv(file_a_path, dtype=str).fillna("")
        df_b = pd.read_csv(file_b_path, dtype=str).fillna("")

        # CRITICAL: Force all headers to lowercase and strip spaces to handle CamelCase vs lower
        df_a.columns = [c.lower().strip() for c in df_a.columns]
        df_b.columns = [c.lower().strip() for c in df_b.columns]

        # Define columns used to match rows (must match the lowercase headers above)
        match_cols = ["area", "screen name", "screen number", "field name", "field number", "level", "row", "column"]

        print("Step 2: Merging data (Outer Join)...")
        # indicator=True creates the '_merge' column
        merged = pd.merge(df_a, df_b, on=match_cols, how='outer', suffixes=('_base', ''), indicator=True)

        # --- 3. LOGIC FOR STATUS ---
        merged['comparison_status'] = 'COMMON'
        merged.loc[merged['_merge'] == 'left_only', 'comparison_status'] = 'DELETED ROW'
        merged.loc[merged['_merge'] == 'right_only', 'comparison_status'] = 'NEW ROW'

        print("Step 3: Checking for MODIFIED cells...")
        common_mask = (merged['_merge'] == 'both')
        
        # Check every column that exists in both files for differences
        for col in df_b.columns:
            if col in match_cols or col == '_merge': 
                continue
            
            base_col = f"{col}_base"
            if base_col in merged.columns:
                # Compare stripped values to ignore hidden trailing spaces
                diff_mask = common_mask & (merged[base_col].str.strip() != merged[col].str.strip())
                merged.loc[diff_mask, 'comparison_status'] = 'MODIFIED'

        # Clean up technical columns before writing
        merged = merged.drop(columns=['_merge'])

        # Generate Summary for the first tab
        summary_counts = merged['comparison_status'].value_counts().reset_index()
        summary_counts.columns = ['Status', 'Total Count']

        # --- 4. WRITE TO EXCEL WITH SPLITTING & FORMATTING ---
        print(f"Step 4: Writing {len(merged):,} rows to Excel Sheets...")
        rows_per_sheet = 1000000 
        total_rows = len(merged)
        status_idx = merged.columns.get_loc("comparison_status")

        with pd.ExcelWriter(output_excel, engine='xlsxwriter') as writer:
            workbook = writer.book
            
            # Formatting definitions
            fmt_new = workbook.add_format({'bg_color': '#C6EFCE'}) # Light Green
            fmt_mod = workbook.add_format({'bg_color': '#FFFF99'}) # Yellow
            fmt_del = workbook.add_format({'bg_color': '#E0E0E0'}) # Grey
            fmt_hdr = workbook.add_format({'bold': True, 'bg_color': '#4472C4', 'font_color': 'white', 'border': 1})

            # A. WRITE SUMMARY SHEET
            summary_sheet = workbook.add_worksheet('Executive Summary')
            summary_sheet.write('A1', 'Field Analysis Comparison Summary', workbook.add_format({'bold': True, 'font_size': 14}))
            summary_sheet.write('A2', f'Generated on: {datetime.now().strftime("%Y-%m-%d %H:%M")}')
            
            # Write Table Headers
            summary_sheet.write('A4', 'Status', fmt_hdr)
            summary_sheet.write('B4', 'Record Count', fmt_hdr)
            
            for row_num, (status, count) in enumerate(summary_counts.values):
                summary_sheet.write(row_num + 4, 0, status)
                summary_sheet.write(row_num + 4, 1, count)
            
            summary_sheet.set_column('A:B', 25)

            # B. WRITE DATA SHEETS IN CHUNKS
            for i in range(0, total_rows, rows_per_sheet):
                chunk = merged.iloc[i : i + rows_per_sheet]
                sheet_num = (i // rows_per_sheet) + 1
                sheet_name = f"Data_Part_{sheet_num}"
                print(f"   -> Creating {sheet_name}...")
                
                chunk.to_excel(writer, sheet_name=sheet_name, index=False)
                worksheet = writer.sheets[sheet_name]
                
                # Freeze top row and set column widths
                worksheet.freeze_panes(1, 0)
                worksheet.set_column(0, len(merged.columns)-1, 15)
                
                # Identify Status column letter (e.g., A, B, C...)
                col_letter = chr(65 + status_idx) if status_idx < 26 else "Z"

                # Apply Conditional Formatting (Highlighting)
                worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                    'type':     'formula',
                    'criteria': f'=${col_letter}2="NEW ROW"',
                    'format':   fmt_new
                })
                worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                    'type':     'formula',
                    'criteria': f'=${col_letter}2="MODIFIED"',
                    'format':   fmt_mod
                })
                worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                    'type':     'formula',
                    'criteria': f'=${col_letter}2="DELETED ROW"',
                    'format':   fmt_del
                })

        print(f"\n✅ PROCESS COMPLETE")
        print(f"Total Records Analyzed: {total_rows:,}")
        print(f"Output saved to: {output_excel}")

    except Exception as e:
        print(f"❌ AN ERROR OCCURRED: {e}")

if __name__ == "__main__":
    run_full_process()
