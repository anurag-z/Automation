using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using ExcelDataReader;

public class ExcelStreamer
{
    public static void Main(string[] args)
    {
        // Works for .xlsx, .xls, and .csv
        string pathA = "FileA.xlsx";
        string pathB = "FileB.xlsx";

        CompareLargeFiles(pathA, pathB);
    }

    public static void CompareLargeFiles(string pathA, string pathB)
    {
        Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);

        using var streamA = File.Open(pathA, FileMode.Open, FileAccess.Read);
        using var streamB = File.Open(pathB, FileMode.Open, FileAccess.Read);

        using var readerA = GetReader(pathA, streamA);
        using var readerB = GetReader(pathB, streamB);

        int rowCount = 0;
        int diffCount = 0;

        // Move past headers if necessary
        readerA.Read(); 
        readerB.Read();

        // Read both files simultaneously row-by-row
        while (readerA.Read() && readerB.Read())
        {
            rowCount++;
            
            // Get the field values for the current row
            var valuesA = GetRowValues(readerA);
            var valuesB = GetRowValues(readerB);

            if (!valuesA.SequenceEqual(valuesB))
            {
                diffCount++;
                Console.WriteLine($"Difference found at row {rowCount}:");
                Console.WriteLine($"File B Row: {string.Join(" | ", valuesB)}");
                Console.WriteLine("-------------------------------------------");
            }
        }

        Console.WriteLine($"Finished. Checked {rowCount} rows. Found {diffCount} differences.");
    }

    private static IExcelDataReader GetReader(string path, Stream stream)
    {
        return path.EndsWith(".csv", StringComparison.OrdinalIgnoreCase) 
            ? ExcelReaderFactory.CreateCsvReader(stream) 
            : ExcelReaderFactory.CreateReader(stream);
    }

    private static object[] GetRowValues(IExcelDataReader reader)
    {
        object[] values = new object[reader.FieldCount];
        reader.GetValues(values);
        return values;
    }
}
