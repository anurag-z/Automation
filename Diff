using System;
using System.Data;
using System.IO;
using System.Linq;
using System.Text;
using ExcelDataReader;

public class ExcelDiffChecker
{
    public static void Main(string[] args)
    {
        // Replace with your actual file paths
        string pathA = "FileA.xlsx";
        string pathB = "FileB.xlsx";

        try 
        {
            DataTable differences = GetMismatchedRowsFromB(pathA, pathB);
            
            Console.WriteLine($"Comparison Complete. Found {differences.Rows.Count} rows in File B that differ from File A.");
            
            foreach (DataRow row in differences.Rows)
            {
                Console.WriteLine(string.Join(" | ", row.ItemArray));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    public static DataTable GetMismatchedRowsFromB(string pathA, string pathB)
    {
        // Essential for .NET Core/6+ to support Excel encoding
        Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);

        using var streamA = File.Open(pathA, FileMode.Open, FileAccess.Read);
        using var streamB = File.Open(pathB, FileMode.Open, FileAccess.Read);
        
        using var readerA = ExcelReaderFactory.CreateReader(streamA);
        using var readerB = ExcelReaderFactory.CreateReader(streamB);

        // Configure to treat the first row as headers
        var conf = new ExcelDataSetConfiguration { 
            ConfigureDataTable = _ => new ExcelDataTableConfiguration { UseHeaderRow = true } 
        };

        DataTable dtA = readerA.AsDataSet(conf).Tables[0];
        DataTable dtB = readerB.AsDataSet(conf).Tables[0];

        // Prepare the result table with the same structure as B
        DataTable diffTable = dtB.Clone();

        // Iterate through rows (based on the smaller count to avoid OutOfBounds)
        int maxRows = Math.Min(dtA.Rows.Count, dtB.Rows.Count);

        for (int i = 0; i < maxRows; i++)
        {
            object[] rowA = dtA.Rows[i].ItemArray;
            object[] rowB = dtB.Rows[i].ItemArray;

            // SequenceEqual compares each object in the array
            if (!rowA.SequenceEqual(rowB))
            {
                diffTable.ImportRow(dtB.Rows[i]);
            }
        }

        return diffTable;
    }
}
