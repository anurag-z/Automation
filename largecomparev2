import pandas as pd
import os
from datetime import datetime

# --- 1. CONFIGURATION ---
folder_path = r'C:\Users\C302461\OneDrive - Thomson Reuters Incorporated\Documents\IDesign\New folder\Excel\Data'
file_a_path = os.path.join(folder_path, 'merged_master_data.csv')
file_b_path = os.path.join(folder_path, 'merged_field_analysis.csv')

timestamp = datetime.now().strftime("%Y%m%d_%H%M")
output_excel = os.path.join(folder_path, f'Action_Required_Comparison_{timestamp}.xlsx')

def run_full_process():
    try:
        print("Step 1: Loading files...")
        df_a = pd.read_csv(file_a_path, dtype=str).fillna("")
        df_b = pd.read_csv(file_b_path, dtype=str).fillna("")

        # Normalize headers
        df_a.columns = [c.lower().strip() for c in df_a.columns]
        df_b.columns = [c.lower().strip() for c in df_b.columns]

        # Define columns to keep
        match_cols = ["area", "screen name", "screen number", "field name", "field number", "level", "row", "column"]
        target_col = "action required" # The specific column you want to compare

        print("Step 2: Merging data...")
        # We only take the match columns and the target column from each file
        df_a_sub = df_a[match_cols + [target_col]]
        df_b_sub = df_b[match_cols + [target_col]]

        # Merge - suffixes will create 'action required_base' and 'action required'
        merged = pd.merge(df_a_sub, df_b_sub, on=match_cols, how='outer', suffixes='_base', indicator=True)

        merged['comparison_status'] = 'COMMON'
        merged.loc[merged['_merge'] == 'left_only', 'comparison_status'] = 'DELETED ROW'
        merged.loc[merged['_merge'] == 'right_only', 'comparison_status'] = 'NEW ROW'
        
        # Identify modifications specifically in the "Action Required" column
        print("Step 3: Comparing Action Required values...")
        base_target = f"{target_col}_base"
        new_target = target_col
        
        common_mask = (merged['_merge'] == 'both')
        diff_mask = common_mask & (merged[base_target].str.strip() != merged[new_target].str.strip())
        
        merged.loc[diff_mask, 'comparison_status'] = 'MODIFIED'
        
        # Clean up technical merge column
        merged = merged.drop(columns=['_merge'])

        # --- 4. WRITE TO EXCEL ---
        print(f"Step 4: Writing {len(merged):,} rows to Excel...")
        rows_per_sheet = 1000000 
        total_rows = len(merged)
        
        # Indices for highlighting
        status_idx = merged.columns.get_loc("comparison_status")
        target_idx = merged.columns.get_loc(new_target)

        with pd.ExcelWriter(output_excel, engine='xlsxwriter') as writer:
            workbook = writer.book
            
            # Formatting
            fmt_new = workbook.add_format({'bg_color': '#C6EFCE'}) # Green
            fmt_del = workbook.add_format({'bg_color': '#E0E0E0'}) # Grey
            fmt_mod = workbook.add_format({'bg_color': '#FFFF99'}) # Yellow
            fmt_diff = workbook.add_format({'bg_color': '#FF9999', 'font_color': '#9C0006'}) # Red/Pink

            for i in range(0, total_rows, rows_per_sheet):
                chunk = merged.iloc[i : i + rows_per_sheet]
                sheet_name = f"Action_Comparison_P{(i // rows_per_sheet) + 1}"
                print(f"   -> Creating {sheet_name}...")
                
                chunk.to_excel(writer, sheet_name=sheet_name, index=False)
                worksheet = writer.sheets[sheet_name]
                worksheet.freeze_panes(1, 0)

                # Determine column letters for logic
                status_let = chr(65 + status_idx) if status_idx < 26 else "J"
                
                # 1. Row Level: NEW and DELETED
                worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                    'type': 'formula', 'criteria': f'=${status_let}2="NEW ROW"', 'format': fmt_new
                })
                worksheet.conditional_format(1, 0, len(chunk), len(merged.columns)-1, {
                    'type': 'formula', 'criteria': f'=${status_let}2="DELETED ROW"', 'format': fmt_del
                })

                # 2. Status Level: MODIFIED (Yellow)
                worksheet.conditional_format(1, status_idx, len(chunk), status_idx, {
                    'type': 'cell', 'criteria': 'equal to', 'value': '"MODIFIED"', 'format': fmt_mod
                })

                # 3. Cell Level: If MODIFIED, turn the NEW 'Action Required' cell Red
                worksheet.conditional_format(1, target_idx, len(chunk), target_idx, {
                    'type': 'formula', 'criteria': f'=${status_let}2="MODIFIED"', 'format': fmt_diff
                })

        print(f"\n✅ CLEAN REPORT READY: {output_excel}")
        print("Included columns: Match Keys, Action Required (Base), Action Required (New), Status")

    except Exception as e:
        print(f"❌ Error: {e}")

if __name__ == "__main__":
    run_full_process()
