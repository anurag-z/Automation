import pandas as pd
import glob
import os

# 1. Get the current folder where the script is saved
current_folder = os.getcwd()
print(f"Looking for files in: {current_folder}")

# 2. Look for all types of Excel files (.xlsx, .xls, .xlsb)
extension = "*.xlsx" 
all_files = glob.glob(os.path.join(current_folder, extension))

if not all_files:
    print("❌ ERROR: No Excel files found! Make sure your files end in .xlsx and are in the same folder as this script.")
else:
    print(f"✅ Found {len(all_files)} files: {all_files}")
    
    output_file = 'final_merged_master_data.csv'
    all_dfs = []

    for file in all_files:
        print(f"Processing: {os.path.basename(file)}")
        excel_data = pd.ExcelFile(file)
        
        for sheet in excel_data.sheet_names:
            print(f"   - Reading sheet: {sheet}")
            df = pd.read_excel(file, sheet_name=sheet)
            
            # Clean headers
            df.columns = [str(col).strip().lower() for col in df.columns]
            all_dfs.append(df)

    # 3. Combine everything
    if all_dfs:
        print("Combining all data...")
        master_df = pd.concat(all_dfs, ignore_index=True)
        master_df.to_csv(output_file, index=False)
        print(f"Done! Created: {output_file}")
    else:
        print("❌ No data was loaded from the sheets.")
