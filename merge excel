import pandas as pd
import glob
import os

# 1. PASTE YOUR FOLDER PATH HERE (Use 'r' before the quotes)
folder_path = r'C:\Users\C302461\OneDrive - Thomson Reuters Incorporated\Documents\IDesign\New folder\Excel\Data'

# 2. Look for all .xlsx files in that specific folder
search_pattern = os.path.join(folder_path, "*.xlsx")
all_files = glob.glob(search_pattern)

if not all_files:
    print(f"❌ No Excel files found in: {folder_path}")
    print("Check if the path is correct or if the files are .xlsb/.csv instead.")
else:
    print(f"✅ Found {len(all_files)} files.")
    
    all_dfs = []
    output_file = os.path.join(folder_path, 'merged_master_data.csv')

    for file in all_files:
        print(f"Processing: {os.path.basename(file)}")
        # Use 'engine' to ensure it handles newer Excel formats correctly
        excel_data = pd.ExcelFile(file, engine='openpyxl')
        
        for sheet in excel_data.sheet_names:
            print(f"   -> Reading sheet: {sheet}")
            df = pd.read_excel(file, sheet_name=sheet)
            
            # Clean headers to ensure they align perfectly
            df.columns = [str(col).strip().lower() for col in df.columns]
            all_dfs.append(df)

    # 3. Final Merge
    if all_dfs:
        print("Merging all data into one...")
        master_df = pd.concat(all_dfs, ignore_index=True)
        master_df.to_csv(output_file, index=False)
        print(f"🚀 SUCCESS! File saved at: {output_file}")
    else:
        print("❌ No data found in the sheets.")
