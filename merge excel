import pandas as pd
import glob
import os

# 1. Direct folder path
folder_path = r'C:\Users\C302461\OneDrive - Thomson Reuters Incorporated\Documents\IDesign\New folder\Excel\Data'
target_sheet = "Field Analysis"  # The specific sheet name you want
output_file = os.path.join(folder_path, 'merged_field_analysis.csv')

# 2. Look for .xlsx files
search_pattern = os.path.join(folder_path, "*.xlsx")
all_files = glob.glob(search_pattern)

if not all_files:
    print(f"❌ No Excel files found in: {folder_path}")
else:
    print(f"✅ Found {len(all_files)} files. Starting extraction...")
    
    all_dfs = []

    for file in all_files:
        file_name = os.path.basename(file)
        try:
            # We use pd.read_excel directly with sheet_name
            print(f"Reading '{target_sheet}' from {file_name}...")
            df = pd.read_excel(file, sheet_name=target_sheet)
            
            # Clean headers (lowercase and strip spaces)
            df.columns = [str(col).strip().lower() for col in df.columns]
            
            all_dfs.append(df)
        except ValueError:
            # This happens if the specific sheet name is missing in one of the files
            print(f"⚠️ Skipping {file_name}: Sheet '{target_sheet}' not found.")

    # 3. Final Merge
    if all_dfs:
        print(f"Merging {len(all_dfs)} sheets...")
        master_df = pd.concat(all_dfs, ignore_index=True)
        master_df.to_csv(output_file, index=False)
        print(f"🚀 SUCCESS! Merged file saved at: {output_file}")
    else:
        print("❌ No data was loaded. Check if the sheet name matches exactly (case-sensitive).")
